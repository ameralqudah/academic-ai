{
  "name": "academic-ai-research-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:integration": "tsx scripts/integration.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
